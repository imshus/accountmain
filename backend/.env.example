# Copy this file to backend/.env (same folder), fill in the database address and the OpenAI key, then restart the backend.

# The database (required): the one store of the books, uploads and chats. Nothing is kept on this server's disk, so the
# server can be rebuilt or moved and finds everything there. Supabase > your project > Connect > "Session pooler"
# (port 5432; not the transaction pooler on 6543), the URI with the database password in it. If the password has
# characters such as @ : / % # ? +, leave [YOUR-PASSWORD] in the address and put the password, as it is, in
# DATABASE_PASSWORD instead. Keep both secret: they stay on this server and are never printed (messages name only the
# host). Back-ups: Supabase > Database > Backups. Use a separate Supabase project (or a local PostgreSQL) for
# development, so a test on your PC never changes the real books.
# e.g. postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# DATABASE_PASSWORD=
# DATABASE_SCHEMA=accountsai        # the app's tables live in this schema, which Supabase's web API does not expose
# DATABASE_POOL_SIZE=5              # connections kept open to the database (as many more are opened when busy)

# GPT-6 Luna (the chat model). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase (optional): every uploaded document is also stored in a private Supabase Storage bucket.
# Supabase > Project Settings: the Project URL (https://...supabase.co) and, under API Keys > Secret keys, a secret
# key (sb_secret_...; a legacy service_role key eyJ... also works). Keep it secret: it stays on this server.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=documents         # created private if missing; a public bucket is refused
# SUPABASE_FOLDER=uploads           # files go to <bucket>/<folder>/<YYYY-MM>/<upload id>-<fingerprint>-<file name>

# MongoDB (optional): a live copy of the app's records in MongoDB (Atlas works): each upload with its sheets' statistics,
# notes and report setup (collection "uploads"), and every chat conversation (collection "chats"). The sheets' rows and
# the company books stay in the database only. Atlas > Connect > Drivers: the mongodb+srv:// string, with the database user's
# password in it, percent-encoded (@ as %40, : as %3A, / as %2F, ? as %3F, + as %2B, % as %25; a bare + reads as a
# space; Python's urllib.parse.quote_plus encodes it). Keep it secret: it stays on this server and is never printed.
# A plain mongodb:// address needs tls=true, unless MongoDB runs on this machine.
# MONGODB_URI=mongodb+srv://accountsai:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# (MONGO_DB_URL works too; without user:password in it, MONGO_DB_USER and MONGO_DB_PASSWORD are added, encoded)
# MONGODB_DB=accountsai             # give the database user readWrite on this database only

# Optional settings (defaults shown)
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low      # first answer: none | low | medium | high | xhigh | max (higher = slower)
# OPENAI_REPAIR_EFFORT=medium      # used only when a figure in the answer fails the check
# OPENAI_FOLLOWUP_EFFORT=low       # the suggested next questions shown under an answer
# OPENAI_SERVICE_TIER=priority     # optional: faster processing from OpenAI at a higher price per token
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost

